{
  "name": "flattery103/simplemspdoc",
  "description": "Self-hosted IT documentation for internal IT and MSPs",
  "license": "GPL-3.0-or-later",
  "require": {
    "php": ">=8.3",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-mbstring": "*",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-openssl": "*",
    "nikic/fast-route": "^1.3",
    "ezyang/htmlpurifier": "^4.18",
    "spomky-labs/otphp": "^11.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "SimpleMSPDoc\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SimpleMSPDoc\\Tests\\": "../tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    },
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit --configuration ../phpunit.xml"
  }
}
